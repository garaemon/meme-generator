{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meme-generator",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only the image proxy needs the Worker; everything else is served
    // straight from static assets.
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  },
  // Workers Builds creates a Preview with a stable workers.dev URL for every
  // non-production branch and posts it on the pull request. The Worker has
  // no vars or storage bindings, so Previews need no separate settings.
  "preview_urls": true,
  "previews": {
    "observability": {
      "enabled": true
    }
  }
}
